  {
    "id": "ex1parse00000000",
    "type": "function",
    "z": "ex1tab0000000001",
    "name": "parse TEMP / LED",
    "func": "const line = String(msg.payload).trim();\nif (line.startsWith('TEMP:')) {\n    const t = parseFloat(line.slice(5));\n    if (isNaN(t)) return null;\n    node.status({fill: 'blue', shape: 'dot', text: t + ' °C'});\n    return [{topic: 'temperature', payload: t}, null];\n}\nif (line.startsWith('LED:')) {\n    const s = line.slice(4).trim();\n    node.status({fill: s === 'ON' ? 'yellow' : 'grey', shape: 'dot', text: 'LED ' + s});\n    return [null, {topic: 'led', payload: s}];\n}\nreturn null; // info lines starting with '#'",
    "outputs": 2,
    "x": 400,
    "y": 120,
    "wires": [
      [
        "ex1tempdebug0000"
      ],
      [
        "ex1leddebug00000"
      ]
    ]
  },
