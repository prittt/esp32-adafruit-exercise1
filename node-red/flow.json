[
  {
    "id": "ex1tab0000000001",
    "type": "tab",
    "label": "ESP32 Exercise 1 (serial + Adafruit IO)",
    "disabled": false,
    "info": "1) Double-click 'ESP32 serial in' -> edit the serial port (COM3 on Windows, /dev/ttyUSB0 on Linux, /dev/cu.* on macOS).\n2) Double-click any MQTT node -> edit 'Adafruit IO' broker -> Security tab: Username = your Adafruit IO username, Password = your Adafruit IO key.\n3) Replace YOUR_AIO_USERNAME in the 3 MQTT node topics with your Adafruit IO username.\n4) Deploy."
  },
